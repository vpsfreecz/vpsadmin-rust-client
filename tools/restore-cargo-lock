#!/usr/bin/env python3
"""Restore the exact CI run's dependency lock into a fresh checkout."""

import argparse
import hashlib
import json
import os
from pathlib import Path


def require(condition, message):
    if not condition:
        raise SystemExit(message)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input_directory", type=Path)
    parser.add_argument("--sha256", required=True, help="expected raw Cargo.lock SHA-256")
    args = parser.parse_args()
    source = args.input_directory
    require({p.name for p in source.iterdir()} == {"Cargo.lock", "identity.json"},
            "Unexpected dependency lock artifact contents")
    require(all(p.is_file() and not p.is_symlink() for p in source.iterdir()),
            "Dependency lock artifact entries must be regular files")
    lock = (source / "Cargo.lock").read_bytes()
    digest = hashlib.sha256(lock).hexdigest()
    require(digest == args.sha256, "Dependency lock digest differs")
    require(json.loads((source / "identity.json").read_text()) == {
        "source": os.environ["GITHUB_SHA"], "run_id": os.environ["GITHUB_RUN_ID"],
        "run_attempt": os.environ["GITHUB_RUN_ATTEMPT"], "lock_sha256": digest},
        "Dependency lock source, run or attempt differs")
    with Path("Cargo.lock").open("xb") as output:
        output.write(lock)


if __name__ == "__main__":
    main()
